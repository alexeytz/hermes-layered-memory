# Hermes Layered Memory — environment variables
# Copy to ~/.hermes/profiles/<profile>/.env and edit values.
# Unprefixed lines are active (set). Lines starting with # are examples/defaults.
#
# REQUIRED variables: [REQUIRED] — plugin will not function correctly without them.
# OPTIONAL variables: [OPTIONAL] — have sensible defaults when absent.

# ==============================================================================
# DATABASE
# ==============================================================================

# [OPTIONAL] SQLite database path for this profile.
# Default: ~/.hermes/hermes-layered-memory-dbs/<profile>.db (auto-created)
# Uncomment and replace <profile> with your profile name:
# HLM_DB_PATH=~/.hermes/hermes-layered-memory-dbs/<profile>.db

# ==============================================================================
# QDRANT (vector search)
# ==============================================================================

# [REQUIRED] Qdrant server URL. Vector search is the primary retrieval path.
# Default: http://localhost:6333
HLM_QDRANT_URL=http://localhost:6333

# [OPTIONAL] Disable Qdrant entirely (SQLite-only mode).
# When false: skips Qdrant initialization and all vector search.
# Fallback: FTS5 BM25 lexical search (slower, no semantic similarity).
# Use for: testing without Qdrant, minimal deployments, air-gapped systems.
# Default: true
# Uncomment for SQLite-only mode — no Qdrant, no Docker needed. Retrieval
# falls back to a cosine scan over the embeddings SQLite already holds, so
# semantic ranking still works; write-time dedup is bypassed.
# HLM_QDRANT_ENABLED=false

# [OPTIONAL] Key collection names to the embedding model — `memories` becomes
# `memories_<model>_<dim>`. A Qdrant collection has one fixed vector size, so a
# shared name breaks every upsert the moment the embedder changes; a keyed name
# means the new model gets a new collection and the old one keeps serving until
# it is rebuilt. Keyed on the *model*, not the dimension: two different 4096-dim
# models share a size but not an embedding space.
# Set false to keep flat names, and the collision that comes with them.
# Default: true
# HLM_QDRANT_COLLECTION_SUFFIX=true

# [OPTIONAL] HTTP timeout (seconds) for the Qdrant client.
# Set explicitly so the value is visible rather than inheriting the
# underlying httpx default (version-dependent, currently 5s) — too short for
# large batch upserts (rebuild), too generous for fail-fast-into-circuit-breaker.
# Default: 30
# HLM_QDRANT_TIMEOUT=30

# ==============================================================================
# EMBEDDING (text → vector)
# ==============================================================================

# [OPTIONAL] Remote embedding endpoint (Ollama `/api/embed`, llama.cpp, etc.).
# When unset: falls back to local sentence-transformers (all-MiniLM-L6-v2, 384-dim).
# Set together with HLM_EMBED_MODEL for higher-dimensional embeddings.
# HLM_EMBED_URL=http://localhost:11434/api/embed

# [OPTIONAL] Embedding model name for the remote endpoint.
# Set together with HLM_EMBED_URL.
# Common choices: qwen3-embedding:8b (4096-dim), multilingual-e5-large (1024-dim, multilingual)
# HLM_EMBED_MODEL=qwen3-embedding:8b

# [OPTIONAL] Query-side instruction prefix for asymmetric embedding models,
# which embed a question and a passage differently. Off by default; measure
# before setting one — tests/eval_retrieval.py --compare A/Bs it against raw
# queries on the golden corpus.
# Default: none
# HLM_QUERY_INSTRUCTION=Instruct: Given a question, retrieve stored facts that answer it\nQuery:

# [OPTIONAL] Local FastEmbed model for offline/embedded use (no Ollama needed).
# When set: overrides the sentence-transformers fallback with FastEmbed.
# Supported: intfloat/multilingual-e5-large (1024-dim, 100+ languages, ~22 texts/sec on T440p).
# Default: none (falls back to sentence-transformers all-MiniLM-L6-v2, 384-dim).
# NOTE: Changing embedding dimension (e.g. 384 → 1024) requires recreating Qdrant collections.
# HLM_LOCAL_EMBED_MODEL=intfloat/multilingual-e5-large

# ==============================================================================
# SUMMARIES (shared across all profiles)
# ==============================================================================

# [OPTIONAL] Directory for summary .md files. All profiles share the same dir.
# Default: ~/Documents/hlm-summaries/
# HLM_SUMMARIES_DIR=~/Documents/hlm-summaries/

# [OPTIONAL] Shared SQLite database for summaries (digests.db).
# All profiles read/write this single file. WAL mode handles concurrency.
# Default: ~/.hermes/hermes-layered-memory-dbs/digests.db
# HLM_SUMMARIES_DB=~/.hermes/hermes-layered-memory-dbs/digests.db

# ==============================================================================
# LAYER PIPELINE DEPTH
# ==============================================================================

# [OPTIONAL] Default maximum layer depth for retrieval.
#   0 = Qdrant only, 1 = Qdrant+SQLite, 2 = +fusion scoring (default),
#   3 = +LLM reranker, 4 = +gap detection
# When set: also disables the heuristic gate auto-bump (no 2→3/4 upgrade).
# The LLM can still explicitly pass max_layer=3/4 to trigger deeper retrieval.
# Default: 2
HLM_MAX_LAYER=2

# [OPTIONAL] Max candidates per data_type collection returned by Layer 0 (Qdrant/FTS5).
# Caps the input to Layer 2 fusion scoring. Lower values reduce CPU at the cost of recall.
# Default: 30
# HLM_LAYER0_TOP_K=30

# ==============================================================================
# LAYER 3 — LLM RERANKER
# ==============================================================================

# [OPTIONAL] Reranker mode: inline (single LLM call), delegate (sub-agent), self (in-context).
# Only used when max_layer >= 3.
# Default: inline
# HLM_LAYER3_MODE=inline

# [OPTIONAL] LLM model name for reranking. Only used when max_layer >= 3.
# HLM_LAYER3_MODEL=QWEN3.6-27B

# [OPTIONAL] Base URL for the LLM endpoint (OpenAI-compatible chat completions API).
# Only used when max_layer >= 3.
# HLM_LAYER3_BASE_URL=http://localhost:8000/v1

# [OPTIONAL] API key for the LLM endpoint.
# Only used when max_layer >= 3.
# HLM_LAYER3_API_KEY=your-api-key

# ==============================================================================
# REASONING MODE (for Qwen3, DeepSeek, Gemma4 via vLLM)
# ==============================================================================

# [OPTIONAL] Control reasoning/thinking mode for all HLM LLM calls
# (enrichment, L3 reranker, L4 gap detection).
#   none  = disable thinking (saves ~700 tokens, ~5s → ~1s per call)
#   low   = minimal reasoning
#   medium = moderate reasoning
#   high  = full reasoning
# Default: model default (may consume all max_tokens on thinking)
HLM_REASONING_EFFORT=none

# Which spelling of "don't think" to send: auto (default), openai, permissive, off.
# Only needed when auto-detection guesses wrong about a proxy — measure first with
# scripts/measure-reasoning-suppression.py. Unrecognised values warn and are ignored.
#HLM_REASONING_STYLE=auto

# ==============================================================================
# METADATA ENRICHMENT
# ==============================================================================

# [OPTIONAL] Enable LLM fallback for topic/keywords during enrichment.
# When false (default): heuristics only (instant, sets data_type + data_id).
# When true: runs LLM classification when heuristics can't fill topic/keywords.
# Cost: ~1-2s and ~100 tokens per add with missing metadata.
# Default: false
# HLM_ENRICH_LLM=false

# ==============================================================================
# SLEEP / CONSOLIDATION
# ==============================================================================

# [OPTIONAL] Number of days before low-trust (<0.3) records are auto-archived
# by layered_sleep(). Records with priority >= 2 are never auto-archived.
# Default: 365
# HLM_LOW_TRUST_ARCHIVE_DAYS=365

# =============================================================================
# CONFLICT DETECTION (post-L2 pipeline)
# =============================================================================

# [OPTIONAL] JSON string for conflict detection thresholds.
# Keys: cosine_min, jaccard_min, jaccard_max, temporal_guard_days, source_guard_days
# Default: {"cosine_min": 0.85, "jaccard_min": 0.7, "jaccard_max": 1.0, "temporal_guard_days": 1, "source_guard_days": 30}
# Lower cosine_min (e.g., 0.75) for more sensitive conflict detection.
# Higher temporal_guard_days (e.g., 14) to skip more sequential entries.
# HLM_CONFLICT_THRESHOLDS={"cosine_min": 0.85, "jaccard_min": 0.7, "temporal_guard_days": 7}

# =============================================================================
# DEDUPLICATION
# =============================================================================

# [OPTIONAL] Cosine similarity threshold for duplicate detection on add().
# When a new record's embedding cosine similarity exceeds this threshold
# against an existing record in the same collection, the add is blocked and
# the existing UUID is returned (status: "duplicate" or "possible_duplicate").
# Use lower values (e.g., 0.85) for stricter dedup; higher values (e.g., 0.99)
# for more permissive. 0.0 disables dedup entirely.
# Default: 0.97
# HLM_DEDUP_THRESHOLD=0.97

# =============================================================================
# FILESYSTEM ACCESS (layered_io)
# =============================================================================
# Both roots default to the real home directory (resolved via pwd, not `~`),
# and paths are compared after realpath resolution. A path outside every
# allowed root is rejected before the filesystem is touched.

# [OPTIONAL] Colon-separated absolute paths that layered_io(action="obsidian_ingest")
# may read vaults from. A vault_path outside all allowed roots is rejected.
# Default: the real home directory only
# HLM_OBSIDIAN_VAULT_ROOTS=/mnt/vaults:/srv/obsidian

# [OPTIONAL] Colon-separated absolute paths that layered_io(action="import")
# may read a file path from. A path outside all allowed roots is rejected.
# Default: the real home directory only
# HLM_IMPORT_ALLOWED_ROOTS=/mnt/exports

# =============================================================================
# LOGGING
# =============================================================================

# [OPTIONAL] Log level: DEBUG, INFO, WARNING, ERROR.
# Use DEBUG for full layer-by-layer pipeline visibility.
# Default: INFO
HLM_LOG=INFO

# [OPTIONAL] Custom log file path. Overrides the default location.
# Default: <hermes-home>/logs/hermes-layered-memory.log
# HLM_LOG_FILE=~/custom/path/layered.log

# [OPTIONAL] Enable query-path tracing (records layer steps per retrieval).
# Default: disabled. Set to 'true' to record traces to {db_dir}/.hlm-traces/.
# HLM_TRACING=true

# [OPTIONAL] Inject knowledge base overview into system prompt at session start.
# Default: disabled. Set to 'true' to show record groups and top trusted memory.
# HLM_SEED_OVERVIEW=true
